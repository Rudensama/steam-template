[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/lobby/chat_panel.gd" id="1"]

[node name="ChatPanel" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ChatTitle" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Chat"

[node name="MessageScroll" type="ScrollContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="MessageList" type="VBoxContainer" parent="VBox/MessageScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="ChatRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ChatInput" type="LineEdit" parent="VBox/ChatRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Type a message and press Enter"

[node name="SendButton" type="Button" parent="VBox/ChatRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Send"
