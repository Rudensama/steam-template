[resource]
default_font_size = 15
Button/colors/font_color = Color(0.843, 0.859, 0.894, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(0.753, 0.776, 0.824, 1)
Button/colors/font_disabled_color = Color(0.357, 0.384, 0.447, 1)
Button/styles/normal = SubResource("btn_normal")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus = SubResource("btn_hover")
AccentButton/base_type = &"Button"
AccentButton/colors/font_color = Color(1, 1, 1, 1)
AccentButton/colors/font_hover_color = Color(1, 1, 1, 1)
AccentButton/colors/font_pressed_color = Color(0.9, 0.94, 1, 1)
AccentButton/styles/normal = SubResource("accent_normal")
AccentButton/styles/hover = SubResource("accent_hover")
AccentButton/styles/pressed = SubResource("accent_pressed")
AccentButton/styles/disabled = SubResource("btn_disabled")
AccentButton/styles/focus = SubResource("accent_hover")
DangerButton/base_type = &"Button"
DangerButton/colors/font_color = Color(1, 1, 1, 1)
DangerButton/colors/font_hover_color = Color(1, 1, 1, 1)
DangerButton/styles/normal = SubResource("danger_normal")
DangerButton/styles/hover = SubResource("danger_hover")
DangerButton/styles/pressed = SubResource("danger_pressed")
DangerButton/styles/disabled = SubResource("btn_disabled")
DangerButton/styles/focus = SubResource("danger_hover")
LineEdit/colors/font_color = Color(0.902, 0.914, 0.937, 1)
LineEdit/colors/font_placeholder_color = Color(0.42, 0.447, 0.502, 1)
LineEdit/colors/caret_color = Color(0.298, 0.545, 0.961, 1)
LineEdit/styles/normal = SubResource("edit_normal")
LineEdit/styles/focus = SubResource("edit_focus")
OptionButton/colors/font_color = Color(0.843, 0.859, 0.894, 1)
OptionButton/colors/font_hover_color = Color(1, 1, 1, 1)
OptionButton/styles/normal = SubResource("btn_normal")
OptionButton/styles/hover = SubResource("btn_hover")
OptionButton/styles/pressed = SubResource("btn_pressed")
OptionButton/styles/disabled = SubResource("btn_disabled")
OptionButton/styles/focus = SubResource("btn_hover")
PanelContainer/styles/panel = SubResource("panel")
Label/colors/font_color = Color(0.843, 0.859, 0.894, 1)
