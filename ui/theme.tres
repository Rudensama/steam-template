[gd_resource type="Theme" load_steps=14 format=3]

; Shared dark UI theme for the Steam multiplayer template. Only the items we want
; to restyle are defined here — everything else falls back to Godot's built-in
; default theme. Tweak the colours in one place and the whole game follows.
;
; Type variations for accent (primary) and danger (destructive) buttons: set a
; control's `theme_type_variation` to &"AccentButton" or &"DangerButton".

[sub_resource type="StyleBoxFlat" id="panel"]
bg_color = Color(0.118, 0.133, 0.169, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.184, 0.208, 0.259, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
content_margin_left = 14.0
content_margin_top = 14.0
content_margin_right = 14.0
content_margin_bottom = 14.0

